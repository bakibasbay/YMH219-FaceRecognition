<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>FaceRecognition</RootNamespace>
    <AssemblyName>YMH219-FaceRecognition</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET 8 çalışma zamanı yoksa daha yeni sürümde (ör. .NET 10) çalışabilsin -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenCV için .NET sarmalayıcısı (face/contrib modülü dahil: LBPHFaceRecognizer) -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <!-- Mat <-> Bitmap dönüşümü -->
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20261107" />
    <!-- Windows için yerel OpenCV kütüphaneleri -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
  </ItemGroup>

  <ItemGroup>
    <!-- Haar cascade yüz algılama modeli çıktı klasörüne kopyalanır -->
    <None Update="Cascades\haarcascade_frontalface_default.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
